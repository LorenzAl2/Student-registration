#include <iostream>
using namespace std;

int main() {
    int numbers[10];
    int search;
    bool found = false;

    // Input 10 numbers
    cout << "Enter 10 numbers:" << endl;
    for (int i = 0; i < 10; i++) {
        cin >> numbers[i];
    }

    // Number to search
    cout << "Enter number to search: ";
    cin >> search;

    // Search
    for (int i = 0; i < 10; i++) {
        if (numbers[i] == search) {
            cout << "Number found at index: " << i << endl;
            found = true;
            break;
        }
    }

    // If not found
    if (!found) {
        cout << "Not found" << endl;
    }

    return 0;
}
